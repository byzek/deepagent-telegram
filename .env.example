# =============================================================================
# deepagent-telegram — environment configuration
# Copy to `.env` and fill in the REQUIRED values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM backend (your private OpenAI-compatible deployment)
# -----------------------------------------------------------------------------
# NOTE: `host.docker.internal` is the correct Docker DNS name for "the host
# machine" (you wrote host.docker.local, which does not resolve). On Linux this
# is wired up via the `host-gateway` mapping in docker-compose.yml.
LLM_BASE_URL=http://host.docker.internal:8080/v1

# REQUIRED: the model id your endpoint serves (check GET /v1/models).
LLM_MODEL=local-model

# Leave blank if your endpoint requires no auth.
LLM_API_KEY=

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
# Timeouts are activity-based, not total-duration-based. The model streams, so
# we keep waiting as long as tokens are actually arriving — great for slow boxes
# and large contexts, and you don't retune a total timer per model.
#   LLM_STREAM_IDLE_TIMEOUT: max seconds with NO new output before giving up.
#     Only needs to cover the longest silent gap (usually time-to-first-token /
#     prompt prefill), NOT total generation length.
#   LLM_HARD_TIMEOUT: absolute ceiling for one whole turn (safety net).
# Set either to 0 to disable that limit.
LLM_STREAM_IDLE_TIMEOUT=300
LLM_HARD_TIMEOUT=3600

# -----------------------------------------------------------------------------
# Embeddings (for semantic memory). Defaults to the SAME endpoint as the LLM.
# -----------------------------------------------------------------------------
# REQUIRED: the embedding model id your endpoint serves.
EMBEDDINGS_MODEL=text-embedding-3-small
# REQUIRED: output dimensionality of that model (must match it exactly).
#   text-embedding-3-small = 1536, bge-base = 768, e5-large = 1024, etc.
EMBEDDINGS_DIMS=1536
# Optional overrides (default to LLM_BASE_URL / LLM_API_KEY):
# EMBEDDINGS_BASE_URL=http://host.docker.internal:8080/v1
# EMBEDDINGS_API_KEY=

# -----------------------------------------------------------------------------
# Memory backend (semantic long-term memory + skills). Easy swap.
#   pgvector  (default, recommended) | qdrant | inmemory
# If you set `qdrant`, start the stack WITH: docker compose --profile qdrant up -d
# -----------------------------------------------------------------------------
MEMORY_BACKEND=pgvector
MEMORY_SEARCH_LIMIT=5
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=agent_memory

# -----------------------------------------------------------------------------
# Messaging front-ends
# -----------------------------------------------------------------------------
# Which platforms to run. Leave blank to auto-enable any with a token set.
# Example: MESSAGING_PLATFORMS=telegram,discord
MESSAGING_PLATFORMS=

# --- Telegram --- (create a bot via @BotFather; ids from @userinfobot)
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=

# --- Discord --- (Developer Portal bot; enable "Message Content Intent")
DISCORD_BOT_TOKEN=
ALLOWED_DISCORD_USER_IDS=

# -----------------------------------------------------------------------------
# Postgres (checkpointer + pgvector store + metrics)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=deepagent
POSTGRES_USER=deepagent
POSTGRES_PASSWORD=change-me-strong-password

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------
SEARXNG_URL=http://searxng:8080
# REQUIRED by SearXNG: any long random string.  openssl rand -hex 32
SEARXNG_SECRET=change-me-openssl-rand-hex-32
# Brave Search API — CAPTCHA-proof fallback. https://api.search.brave.com/
BRAVE_API_KEY=

# -----------------------------------------------------------------------------
# Sandbox (isolated code execution)
# -----------------------------------------------------------------------------
SANDBOX_URL=http://sandbox:8000
# REQUIRED shared secret.  openssl rand -hex 32
SANDBOX_TOKEN=change-me-openssl-rand-hex-32
SANDBOX_TIMEOUT=120

# -----------------------------------------------------------------------------
# Metrics / dashboard
# -----------------------------------------------------------------------------
# How often (seconds) to sample the agent container's network counters.
NET_SAMPLE_INTERVAL=5
NET_METRICS_RETENTION_HOURS=72

# Savings panel: price your local token volume against a cloud model you'd
# otherwise use. Defaults track a GPT-4o-class model ($ per 1M tokens). Local
# compute is treated as ~free, so "savings" = the cloud cost you avoided.
CLOUD_COMPARE_MODEL=gpt-4o
CLOUD_INPUT_PER_1M=2.50
CLOUD_OUTPUT_PER_1M=10.00

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
AGENT_NAME=deepagent
